+// =============================================================================
+// GATE G0 — the lip_v5 computed cash feed (`data/lip_cash_feed.json`).
+//
+// A SEPARATE file from `external_cash.jsonl` on purpose: that one is a cumulative
+// append-log summed line by line, so a computed value appended there would
+// double-count against the operator's hand rows while making two processes write
+// one file.
+//
+// **Default OFF.** Until `LIP_CASH_FEED_ENABLED` is set truthy, `read_lip_cash_feed`
+// returns (0.0, 0.0) before touching the filesystem, so `divergence` is
+// byte-identical to today. That inertness is what G0 reviews; flipping the flag is
+// a separate, human-gated decision with its own read-out.
+//
+// v5 publishes this file BEFORE every cash-consuming POST and corrects it after the
+// response, so its `delta_dollars` is never ABOVE the truth, only below. The
+// breaker's dangerous direction (missing money) therefore stays tight, and v5
+// cannot cause a false halt.
+// =============================================================================
+const LIP_CASH_FEED_PATH: &str = "data/lip_cash_feed.json";
+const LIP_CASH_FEED_SCHEMA: &str = "lip_cash_feed/1";
+/// 4 x v5's 30 s heartbeat: survives one miss plus jitter.
+const LIP_CASH_FEED_STALE_S: f64 = 120.0;
+
+fn lip_cash_feed_enabled() -> bool {
+    matches!(
+        std::env::var("LIP_CASH_FEED_ENABLED")
+            .unwrap_or_default()
+            .trim()
+            .to_ascii_lowercase()
+            .as_str(),
+        "1" | "true" | "yes"
+    )
+}
+
+/// One parsed reading of the feed. `status` drives logging and paging; `delta` and
+/// `pending` are (0.0, 0.0) unless the reading is usable.
+#[derive(Debug, PartialEq)]
+struct LipFeedRead {
+    delta: f64,
+    pending: f64,
+    seq: u64,
+    age_s: f64,
+    status: &'static str,
+}
+
+/// PURE parse, split out so it is testable without touching the environment or the
+/// filesystem (the enabled path is otherwise only reachable via a process-global env
+/// var and a fixed relative path, which makes for racy tests).
+fn parse_lip_cash_feed(text: &str, now_s: f64) -> LipFeedRead {
+    let bad = |status| LipFeedRead {
+        delta: 0.0,
+        pending: 0.0,
+        seq: 0,
+        age_s: 0.0,
+        status,
+    };
+    // A partially-written file cannot occur (v5 writes temp + rename), so a parse
+    // failure means something else is wrong. Contribute NOTHING rather than a
+    // partial reading: a half-understood cash number is worse than none.
+    let v: serde_json::Value = match serde_json::from_str(text) {
+        Ok(v) => v,
+        Err(_) => return bad("unparseable"),
+    };
+    if v.get("schema").and_then(|x| x.as_str()) != Some(LIP_CASH_FEED_SCHEMA) {
+        return bad("schema_mismatch");
+    }
+    // A schema-valid file whose money fields are MISSING or NON-NUMERIC is malformed,
+    // not "zero". Defaulting those to 0.0 would silently drop v5's entire consumption
+    // from the breaker's expectation — indistinguishable, from the outside, from v5
+    // holding no position at all.
+    let delta = match v.get("delta_dollars").and_then(|x| x.as_f64()) {
+        Some(d) if d.is_finite() => d,
+        _ => return bad("malformed_delta_dollars"),
+    };
+    let pending = match v.get("pending_payout_dollars").and_then(|x| x.as_f64()) {
+        Some(p) if p.is_finite() => p,
+        _ => return bad("malformed_pending_payout_dollars"),
+    };
+    let ts = match v.get("ts").and_then(|x| x.as_f64()) {
+        Some(t) if t.is_finite() => t,
+        _ => return bad("malformed_ts"),
+    };
+    let seq = v.get("seq").and_then(|x| x.as_u64()).unwrap_or(0);
+    let age_s = now_s - ts;
+    LipFeedRead {
+        delta,
+        pending,
+        seq,
+        age_s,
+        status: if age_s > LIP_CASH_FEED_STALE_S {
+            "stale"
+        } else {
+            "ok"
+        },
+    }
+}
+
+/// Read the feed. Returns (delta, pending, page) where `page` is Some(message) when a
+/// human needs to be told. The caller owns the paging so this stays synchronous.
+fn read_lip_cash_feed(now_s: f64) -> (f64, f64, Option<String>) {
+    if !lip_cash_feed_enabled() {
+        return (0.0, 0.0, None); // G0: inert until the flag flips.
+    }
+    // An ABSENT file is (0, 0). That is correct only if v5 is truly flat, which v5's
+    // SIGTERM path guarantees: it writes a final zeroed feed after cancel-all + shed,
+    // and only then may the file be removed.
+    let text = match std::fs::read_to_string(LIP_CASH_FEED_PATH) {
+        Ok(t) => t,
+        Err(_) => return (0.0, 0.0, None),
+    };
+    let r = parse_lip_cash_feed(&text, now_s);
+    match r.status {
+        "ok" => {
+            logging::info(format!(
+                "lip_cash_feed OK - seq {} delta ${:.2} pending ${:.2} age {:.0}s",
+                r.seq, r.delta, r.pending, r.age_s
+            ));
+            (r.delta, r.pending, None)
+        }
+        "stale" => {
+            // PAGE, DO NOT HALT. The last value is conservative by construction (v5
+            // over-reports its own consumption), so continuing to use it is safe,
+            // whereas halting here would convert v5 dying into nestor dying.
+            let msg = format!(
+                "lip_cash_feed_stale: seq {} is {:.0}s old (> {LIP_CASH_FEED_STALE_S:.0}s) \
+                 - using last value, NOT halting",
+                r.seq, r.age_s
+            );
+            logging::info(format!("ALERT: {msg}"));
+            eprintln!("[reconcile] ALERT: {msg}");
+            (r.delta, r.pending, Some(msg))
+        }
+        other => {
+            let msg = format!(
+                "lip_cash_feed malformed ({other}) - contributing $0.00, breaker is now \
+                 blind to lip_v5's consumption"
+            );
+            logging::info(format!("ALERT: {msg}"));
+            eprintln!("[reconcile] ALERT: {msg}");
+            (0.0, 0.0, Some(msg))
+        }
+    }
 }
 
