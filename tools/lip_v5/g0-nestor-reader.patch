+/// GATE G0 — the lip_v5 computed cash feed (`data/lip_cash_feed.json`).
+///
+/// Returns (delta_dollars, pending_payout_dollars) to ADD to the operator's
+/// external-cash totals. A SEPARATE file from `external_cash.jsonl` on purpose:
+/// that one is a cumulative append-log summed line by line, and a computed
+/// value appended there would double-count against the operator's hand rows
+/// while making two processes write one file.
+///
+/// **Default OFF.** Until `LIP_CASH_FEED_ENABLED` is set truthy this returns
+/// (0.0, 0.0) before touching the filesystem, so `divergence` is byte-identical
+/// to today. That inertness is what G0 reviews; flipping the flag is a separate,
+/// human-gated decision with its own read-out.
+///
+/// v5 publishes this file BEFORE every cash-consuming POST and corrects it after
+/// the response, so its `delta_dollars` is never ABOVE the truth, only below.
+/// The breaker's dangerous direction (missing money) therefore stays tight, and
+/// v5 cannot cause a false halt.
+const LIP_CASH_FEED_PATH: &str = "data/lip_cash_feed.json";
+const LIP_CASH_FEED_SCHEMA: &str = "lip_cash_feed/1";
+/// 4 x v5's 30 s heartbeat: survives one miss plus jitter.
+const LIP_CASH_FEED_STALE_S: f64 = 120.0;
+
+fn lip_cash_feed_enabled() -> bool {
+    matches!(
+        std::env::var("LIP_CASH_FEED_ENABLED")
+            .unwrap_or_default()
+            .trim()
+            .to_ascii_lowercase()
+            .as_str(),
+        "1" | "true" | "yes"
+    )
+}
+
+fn read_lip_cash_feed(now_s: f64) -> (f64, f64) {
+    if !lip_cash_feed_enabled() {
+        return (0.0, 0.0); // G0: inert until the flag flips.
+    }
+    // An ABSENT file is (0, 0). That is correct only if v5 is truly flat, which
+    // v5's SIGTERM path guarantees: it writes a final zeroed feed after
+    // cancel-all + shed, and only then may the file be removed.
+    let text = match std::fs::read_to_string(LIP_CASH_FEED_PATH) {
+        Ok(t) => t,
+        Err(_) => return (0.0, 0.0),
+    };
+    let v: serde_json::Value = match serde_json::from_str(&text) {
+        Ok(v) => v,
+        // A partially-written file cannot occur (v5 writes temp + rename), so a
+        // parse failure means something else is wrong. Contribute NOTHING rather
+        // than a partial reading: a half-understood cash number is worse than none.
+        Err(e) => {
+            eprintln!("[reconcile] lip_cash_feed.json unparseable, ignored: {e}");
+            return (0.0, 0.0);
+        }
+    };
+    if v.get("schema").and_then(|x| x.as_str()) != Some(LIP_CASH_FEED_SCHEMA) {
+        eprintln!("[reconcile] lip_cash_feed.json schema mismatch, ignored");
+        return (0.0, 0.0);
+    }
+    let delta = v.get("delta_dollars").and_then(|x| x.as_f64()).unwrap_or(0.0);
+    let pending = v
+        .get("pending_payout_dollars")
+        .and_then(|x| x.as_f64())
+        .unwrap_or(0.0);
+    let ts = v.get("ts").and_then(|x| x.as_f64()).unwrap_or(0.0);
+    if now_s - ts > LIP_CASH_FEED_STALE_S {
+        // PAGE, DO NOT HALT. The last value is conservative by construction (v5
+        // over-reports its own consumption), so continuing to use it is safe,
+        // whereas halting here would convert v5 dying into nestor dying.
+        eprintln!(
+            "[reconcile] ALERT lip_cash_feed_stale: {:.0}s old (> {LIP_CASH_FEED_STALE_S:.0}s) \
+             — using last value, NOT halting",
+            now_s - ts
+        );
+    }
+    (delta, pending)
+}
